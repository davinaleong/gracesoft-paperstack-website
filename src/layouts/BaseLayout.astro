---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  author?: string;
  keywords?: string;
  pubDate?: Date;
}

const {
  title = "GraceSoft PaperStack",
  description = "A UI design system that brings the warmth, depth, and tactility of paper to your digital products.",
  canonical,
  ogImage = "/og.png",
  ogType = "website",
  author = "GraceSoft Team",
  keywords = "design system, UI kit, CSS, paper design, design tokens, React, Vue, Svelte, HTML, components",
  pubDate,
} = Astro.props;

const pageTitle =
  title === "GraceSoft PaperStack" ? title : `${title} — GraceSoft PaperStack`;

const siteURL = Astro.site ?? "https://paperstack.gracesoft.dev";
const canonicalURL = canonical ?? new URL(Astro.url.pathname, siteURL).href;
const ogImageURL = new URL(ogImage, siteURL).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#faf8f5" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/logo-square.png" />
    <link rel="apple-touch-icon" href="/logo-square.png" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="GraceSoft PaperStack" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:url" content={canonicalURL} />
    {ogType === "article" && pubDate && (
      <meta property="article:published_time" content={pubDate.toISOString()} />
      <meta property="article:author" content={author} />
      <meta property="article:section" content="Design" />
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@gracesoft_dev" />
    <meta name="twitter:creator" content="@gracesoft_dev" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <title>{pageTitle}</title>

    <!-- Page-specific head overrides -->
    <slot name="head" />

    <script src="https://app.lemonsqueezy.com/js/lemon.js" defer></script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
