---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

function postSlug(id: string) {
  return id.replace(/\.md$/, "");
}

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}

// Adjacent posts for navigation
const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const idx = allPosts.findIndex((p) => p.id === post.id);
const prev = allPosts[idx + 1] ?? null;
const next = allPosts[idx - 1] ?? null;
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="post-article">
    <!-- Post header -->
    <header class="post-header section--bg">
      <div class="container container--narrow">
        <a href="/blog" class="post-back">← Back to Blog</a>

        <div class="post-header__meta">
          <time datetime={post.data.pubDate.toISOString()} class="post-date">
            {formatDate(post.data.pubDate)}
          </time>
          <span class="post-author">{post.data.author}</span>
        </div>

        <h1 class="post-title">{post.data.title}</h1>
        <p class="post-description">{post.data.description}</p>

        {
          post.data.tags.length > 0 && (
            <div class="post-tags">
              {post.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )
        }
      </div>
    </header>

    <!-- Post body -->
    <div class="post-body section--sm">
      <div class="container container--narrow">
        <div class="prose post-prose">
          <Content />
        </div>
      </div>
    </div>

    <!-- Post footer / pagination -->
    <nav class="post-nav section--sm section--bg" aria-label="Post navigation">
      <div class="container container--narrow">
        <div class="post-nav__inner">
          {
            prev ? (
              <a
                href={`/blog/${postSlug(prev.id)}`}
                class="post-nav__link post-nav__link--prev"
              >
                <span class="post-nav__label">← Previous</span>
                <span class="post-nav__title">{prev.data.title}</span>
              </a>
            ) : (
              <div />
            )
          }

          {
            next ? (
              <a
                href={`/blog/${postSlug(next.id)}`}
                class="post-nav__link post-nav__link--next"
              >
                <span class="post-nav__label">Next →</span>
                <span class="post-nav__title">{next.data.title}</span>
              </a>
            ) : (
              <div />
            )
          }
        </div>

        <div class="post-nav__cta">
          <a href="/blog" class="btn btn--outline">All Posts</a>
          <a href="/#contact" class="btn btn--primary">Get Early Access</a>
        </div>
      </div>
    </nav>
  </article>
</BaseLayout>

<style>
  /* ── Post Header ─────────────────────────────────────────── */
  .post-header {
    padding-block: var(--sp-16) var(--sp-12);
  }

  .post-back {
    display: inline-block;
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--clr-subtle);
    margin-bottom: var(--sp-8);
    transition: color var(--duration) var(--ease);
  }

  .post-back:hover {
    color: var(--clr-black);
    opacity: 1;
  }

  .post-header__meta {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    color: var(--clr-subtle);
    letter-spacing: 0.05em;
    margin-bottom: var(--sp-5);
  }

  .post-author::before {
    content: "· ";
  }

  .post-title {
    font-size: clamp(var(--fs-3xl), 5vw, var(--fs-5xl));
    line-height: 1.15;
    margin-bottom: var(--sp-5);
  }

  .post-description {
    font-size: var(--fs-lg);
    color: var(--clr-muted);
    margin-bottom: var(--sp-6);
    line-height: 1.7;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  /* ── Post Body ───────────────────────────────────────────── */
  .post-prose {
    font-size: var(--fs-base);
  }

  .post-prose :global(h2) {
    font-size: var(--fs-3xl);
    margin-top: var(--sp-16);
    margin-bottom: var(--sp-5);
  }

  .post-prose :global(h3) {
    font-size: var(--fs-2xl);
    margin-top: var(--sp-10);
    margin-bottom: var(--sp-4);
  }

  .post-prose :global(p) {
    margin-bottom: var(--sp-6);
    line-height: 1.85;
    color: var(--clr-ink);
  }

  .post-prose :global(ul),
  .post-prose :global(ol) {
    margin-bottom: var(--sp-6);
    padding-left: var(--sp-6);
  }

  .post-prose :global(li) {
    margin-bottom: var(--sp-2);
    color: var(--clr-ink);
    line-height: 1.75;
  }

  .post-prose :global(pre) {
    margin-bottom: var(--sp-6);
  }

  .post-prose :global(blockquote) {
    border-left: 3px solid var(--clr-black);
    padding-left: var(--sp-6);
    font-family: var(--ff-serif);
    font-style: italic;
    font-size: var(--fs-xl);
    color: var(--clr-ink);
    margin-block: var(--sp-8);
  }

  .post-prose :global(hr) {
    width: 4rem;
    height: 2px;
    background: var(--clr-border-dark);
    border: none;
    margin: var(--sp-12) 0;
  }

  .post-prose :global(a) {
    font-weight: 500;
    text-underline-offset: 3px;
  }

  /* ── Post Nav ────────────────────────────────────────────── */
  .post-nav__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-8);
    margin-bottom: var(--sp-8);
  }

  .post-nav__link {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    text-decoration: none;
    padding: var(--sp-5);
    border: 1px solid var(--clr-border);
    background: var(--clr-white);
    box-shadow: var(--shadow-paper);
    transition:
      box-shadow var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }

  .post-nav__link:hover {
    box-shadow: var(--shadow-paper-md);
    transform: translateY(-2px);
    opacity: 1;
  }

  .post-nav__link--next {
    text-align: right;
  }

  .post-nav__label {
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    color: var(--clr-subtle);
  }

  .post-nav__title {
    font-family: var(--ff-serif);
    font-size: var(--fs-base);
    color: var(--clr-black);
    font-weight: 600;
    line-height: 1.4;
  }

  .post-nav__cta {
    display: flex;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }

  @media (max-width: 600px) {
    .post-nav__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
