---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
function postSlug(id: string) {
  return id.replace(/\.md$/, "");
}
function formatDate(date: Date) {
  return date.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}
---

<BaseLayout
  title="Blog"
  description="Product updates, design thinking, and release notes from the GraceSoft PaperStack team."
>
  <section class="section">
    <div class="container">
      <header class="blog-header">
        <span class="eyebrow">From the Team</span>
        <h1>Product Updates &amp; Design Notes</h1>
        <p>
          Thoughts on the paper design philosophy, release notes, and
          behind-the-scenes looks at how PaperStack is built.
        </p>
      </header>

      {
        posts.length === 0 ? (
          <div class="blog-empty">
            <p>No posts yet — check back soon.</p>
          </div>
        ) : (
          <div class="blog-grid">
            {posts.map((post) => (
              <article class="blog-card card">
                <div class="blog-card__meta">
                  <time
                    datetime={post.data.pubDate.toISOString()}
                    class="blog-card__date"
                  >
                    {formatDate(post.data.pubDate)}
                  </time>
                  <span class="blog-card__author">{post.data.author}</span>
                </div>

                <h2 class="blog-card__title">
                  <a
                    href={`/blog/${postSlug(post.id)}`}
                    class="blog-card__title-link"
                  >
                    {post.data.title}
                  </a>
                </h2>

                <p class="blog-card__excerpt">{post.data.description}</p>

                {post.data.tags.length > 0 && (
                  <div class="blog-card__tags">
                    {post.data.tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                )}

                <a
                  href={`/blog/${post.slug}`}
                  class="blog-card__read-more"
                  aria-label={`Read: ${post.data.title}`}
                >
                  Read post →
                </a>
              </article>
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .blog-header {
    max-width: 600px;
    margin-bottom: var(--sp-16);
  }

  .blog-header .eyebrow {
    display: block;
    margin-bottom: var(--sp-3);
  }

  .blog-header h1 {
    font-size: clamp(var(--fs-3xl), 5vw, var(--fs-5xl));
    margin-bottom: var(--sp-4);
    line-height: 1.15;
  }

  .blog-header p {
    font-size: var(--fs-lg);
    color: var(--clr-muted);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--sp-8);
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    background: var(--clr-white);
  }

  .blog-card__meta {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    color: var(--clr-subtle);
    letter-spacing: 0.05em;
  }

  .blog-card__meta::before {
    content: "";
    display: none;
  }

  .blog-card__author::before {
    content: "· ";
  }

  .blog-card__title {
    font-size: var(--fs-xl);
    line-height: 1.3;
    margin: 0;
  }

  .blog-card__title-link {
    text-decoration: none;
    color: var(--clr-black);
    transition: opacity var(--duration) var(--ease);
  }

  .blog-card__title-link:hover {
    opacity: 0.7;
  }

  .blog-card__excerpt {
    font-size: var(--fs-sm);
    color: var(--clr-muted);
    line-height: 1.75;
    margin: 0;
    flex: 1;
  }

  .blog-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .blog-card__read-more {
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--clr-black);
    border-bottom: 1px solid var(--clr-black);
    padding-bottom: 1px;
    align-self: flex-start;
    transition: opacity var(--duration) var(--ease);
  }

  .blog-card__read-more:hover {
    opacity: 0.6;
  }

  .blog-empty {
    text-align: center;
    padding: var(--sp-24);
    color: var(--clr-subtle);
    font-family: var(--ff-mono);
    font-size: var(--fs-sm);
  }
</style>
