---
import { CORE_URL, PRO_URL } from "../data/downloads";

export interface Props {
  framework: "html" | "react" | "vue" | "svelte";
}

const { framework } = Astro.props;
const label = framework.charAt(0).toUpperCase() + framework.slice(1);
---

<div class="download-card">
  <h3>{label}</h3>
  <a href={CORE_URL} class="btn btn--secondary lemonsqueezy-button">
    Get Core — Free
  </a>
  <a href={PRO_URL} class="btn btn--primary lemonsqueezy-button">
    Get Pro — $22
  </a>
</div>
